{
  "name": "@amagaki/amagaki-engine-preact",
  "version": "2.0.1",
  "license": "MIT",
  "homepage": "https://amagaki.dev",
  "repository": {
    "type": "git",
    "url": "git://github.com/blinkk/amagaki.git",
    "directory": "packages/amagaki-engine-preact"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build:example": "amagaki build example",
    "clean": "rm -rf dist",
    "build": "rm -rf dist && tsc && rm -f dist/*.tsbuildinfo",
    "prepack": "npm run build",
    "test": "ava"
  },
  "ava": {
    "extensions": {
      "ts": "commonjs",
      "tsx": "commonjs"
    },
    "require": [
      "esbuild-register"
    ],
    "files": [
      "src/*.test.ts",
      "src/*.test.tsx"
    ],
    "timeout": "20s"
  },
  "devDependencies": {
    "@amagaki/amagaki": "*",
    "@amagaki/amagaki-plugin-page-builder": "*",
    "@types/jsdom": "^21.1.7",
    "ava": "^8.4.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@amagaki/amagaki": "*",
    "esbuild-register": "^3.3.2",
    "preact": "^10.6.6",
    "preact-render-to-string": "^5.1.19"
  },
  "files": [
    "dist/",
    "!**/*.test.*"
  ]
}
