{
  "name": "@amagaki/amagaki-plugin-page-builder",
  "license": "MIT",
  "homepage": "https://amagaki.dev",
  "repository": {
    "type": "git",
    "url": "git://github.com/blinkk/amagaki.git",
    "directory": "packages/amagaki-plugin-page-builder"
  },
  "engines": {
    "node": ">=20"
  },
  "version": "3.12.0",
  "main": "./dist/index.js",
  "scripts": {
    "build:example": "npx amagaki build example",
    "clean": "rm -rf dist",
    "compile": "tsc && node ./scripts/build.mjs",
    "build": "rm -rf dist && npm run compile",
    "prepack": "npm run build",
    "start:example": "npx amagaki serve example",
    "test": "npm run compile && ava"
  },
  "ava": {
    "extensions": {
      "ts": "commonjs"
    },
    "nodeArguments": [
      "--import=tsx"
    ],
    "files": [
      "src/**/*.test.ts"
    ],
    "timeout": "20s"
  },
  "devDependencies": {
    "@blinkk/degu": "3.2.1",
    "@types/js-beautify": "1.14.3",
    "@types/node": "22.20.5",
    "@types/nunjucks": "3.2.6",
    "ava": "6.4.1",
    "esbuild": "0.28.2",
    "nunjucks": "3.2.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@shoelace-style/shoelace": "2.20.1",
    "js-beautify": "1.15.4",
    "lit": "2.8.0",
    "spacingjs": "1.0.9"
  },
  "files": [
    "dist/",
    "!**/*.test.*"
  ]
}
