{
  "name": "@amagaki/amagaki",
  "version": "4.1.0",
  "license": "MIT",
  "homepage": "https://amagaki.dev",
  "repository": {
    "type": "git",
    "url": "git://github.com/blinkk/amagaki.git",
    "directory": "packages/amagaki"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "amagaki": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "files": [
    "dist",
    "!**/*.test.*"
  ],
  "scripts": {
    "build:example": "node ./dist/src/cli.js --profile build example",
    "clean": "rm -rf dist",
    "compile": "tsc && chmod +x dist/src/cli.js",
    "copy": "mkdir -p dist/src/static && cp src/static/* dist/src/static",
    "dev:start": "npm run copy && npm run compile",
    "build": "rm -rf dist && npm run dev:start",
    "prepack": "npm run build",
    "start:example": "node ./dist/src/cli.js serve example",
    "test": "ava",
    "test:watch": "ava --watch"
  },
  "ava": {
    "extensions": {
      "ts": "commonjs"
    },
    "nodeArguments": [
      "--import=tsx"
    ],
    "files": [
      "src/**/*.test.ts"
    ]
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.10.0",
    "@types/nunjucks": "^3.2.6",
    "ava": "^6.4.1",
    "get-port": "^7.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "commander": "^15.1.0",
    "compression": "^1.7.5",
    "esbuild-register": "^3.6.0",
    "express": "^5.3.0",
    "glob": "^14.0.6",
    "isomorphic-git": "^1.27.1",
    "jiti": "^1.21.7",
    "js-yaml": "^4.3.2",
    "marked": "^15.0.12",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-mangle": "^1.1.10",
    "mime-types": "^3.0.2",
    "minimatch": "^11.0.9",
    "nunjucks": "^3.2.4",
    "sucrase": "^3.35.0",
    "tsx": "^4.19.2"
  }
}
