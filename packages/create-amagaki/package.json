{
  "name": "create-amagaki",
  "version": "0.2.0",
  "keywords": [
    "amagaki"
  ],
  "description": "Create Amagaki sites with one command",
  "repository": {
    "type": "git",
    "url": "https://github.com/blinkk/amagaki",
    "directory": "packages/create-amagaki"
  },
  "license": "MIT",
  "bin": {
    "create-amagaki": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "release": "esbuild ./src/index.ts --bundle --platform=node --target=node22 --minify --outfile=./dist/index.js",
    "build": "npm run release",
    "prepack": "npm run release",
    "prepublish": "npm run release",
    "test": ""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "commander": "15.1.0",
    "esbuild": "0.28.2",
    "tar": "7.5.23",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
