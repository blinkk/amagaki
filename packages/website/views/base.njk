{% import "/views/macros/button.njk" as button with context %}
{%- set isHome = doc.fields.layout == 'home' -%}
{%- set isApi = doc.podPath.startsWith('/content/api/') -%}
{%- set isDocs = doc.podPath.startsWith('/content/docs/') -%}
{%- set sidebarRoot = '/content/api' if isApi else '/content/docs' -%}
<!DOCTYPE html>
<html lang="{{doc.locale.id}}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% if doc.fields.description %}<meta name="description" content="{{doc.fields.description}}">{% endif %}
    <link rel="icon" type="image/svg+xml" href="{{pod.staticFile('/static/images/amagaki.svg').url.path}}">
    <title>{% if doc.fields.title %}{{doc.fields.title}}{% if doc.fields.include_site_title !== false %} — {{pod.meta.siteTitle}}{% endif %}{% else %}{{pod.meta.siteTitle}}{% endif %}</title>
    <link rel="stylesheet" href="{{pod.staticFile('/static/css/main.css').url.path}}?v={{pod.staticFile('/static/css/main.css').fingerprint}}">
  </head>
  <body class="{% if isHome %}page-home{% else %}page-docs{% endif %}">
    <header class="topbar">
      <div class="topbar__inner">
        <div class="topbar__left">
          <button
            type="button"
            class="nav-toggle"
            id="nav-toggle"
            aria-label="Toggle navigation"
            aria-controls="docs-sidebar"
            aria-expanded="false"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="3" y1="5" x2="17" y2="5"></line>
              <line x1="3" y1="10" x2="17" y2="10"></line>
              <line x1="3" y1="15" x2="17" y2="15"></line>
            </svg>
          </button>
          <a class="brand" href="/">
            <img class="brand__logo" src="{{pod.staticFile('/static/images/amagaki.svg').url.path}}" alt="" width="28" height="28">
            <span class="brand__name">Amagaki</span>
          </a>
          <nav class="topbar__nav" aria-label="Primary">
            <a href="/docs/" class="topbar__link{% if isDocs %} is-active{% endif %}">Docs</a>
            <a href="/api/" class="topbar__link{% if isApi %} is-active{% endif %}">API</a>
          </nav>
        </div>
        <div class="search-box">
          <input
            type="search"
            id="docs-search"
            class="search-input"
            placeholder="Search docs…"
            autocomplete="off"
            data-index-url="/search-index.json"
          >
          <div id="docs-search-results" class="search-results" hidden></div>
        </div>
        <div class="topbar__actions">
          <a href="{{pod.meta.githubUrl}}" class="btn" target="_blank" rel="noopener" aria-label="GitHub"><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/></svg><span class="btn__label">GitHub</span></a>
        </div>
      </div>
    </header>

    <div class="notice-bar" role="note">
      <div class="notice-bar__inner">
        <span>
          Amagaki is in maintenance mode. For new projects, we recommend
          <a href="https://rootjs.dev" target="_blank" rel="noopener"><img class="notice-bar__icon" src="{{pod.staticFile('/static/images/rootjs-beet.svg').url.path}}" alt="" width="13" height="19">Root.js<svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l14 0"/><path d="M13 18l6 -6"/><path d="M13 6l6 6"/></svg></a>
        </span>
      </div>
    </div>

    <div class="sidebar-backdrop" id="sidebar-backdrop" hidden></div>

    {% if isHome %}
      <aside class="docs-sidebar docs-sidebar--drawer-only" id="docs-sidebar" role="navigation" aria-label="Documentation">
        <div class="sidebar__mobile-header">
          <span>Navigation</span>
          <button type="button" class="nav-close" id="nav-close" aria-label="Close navigation">&times;</button>
        </div>
        <div class="sidebar__mobile-tabs">
          <a href="/docs/" class="topbar__link">Docs</a>
          <a href="/api/" class="topbar__link">API</a>
        </div>
        {% for section in getSidebarSections('/content/docs') %}
          <div class="sidebar__heading">{{section.title}}</div>
          {% for item in section.docs %}
            <a class="sidebar__link" href="{{item.url.path}}">{{item.fields.title}}</a>
          {% endfor %}
        {% endfor %}
      </aside>

      <main class="home-shell" role="main">
        <section class="hero">
          <div class="hero__content">
            <h1 class="hero__title">{{doc.fields.hero.title}}</h1>
            <p class="hero__body">{{doc.fields.hero.body}}</p>
            <div class="hero__actions">
              {% for btn in doc.fields.hero.buttons %}
                {% if btn.variant != 'tertiary' %}
                  {{button.button(btn)}}
                {% endif %}
              {% endfor %}
            </div>
            <div class="hero__tertiary">
              {% for btn in doc.fields.hero.buttons %}
                {% if btn.variant == 'tertiary' %}
                  {{button.button(btn)}}
                {% endif %}
              {% endfor %}
            </div>
          </div>
          <div class="hero__mark">
            <img src="{{pod.staticFile('/static/images/hero-illustration.webp').url.path}}" alt="Amagaki illustration" width="340" height="340">
          </div>
        </section>

        {% if doc.fields.quickstart %}
        <section class="home-section">
          <h2>{{doc.fields.quickstart.title}}</h2>
          <div class="docs-content docs-content--compact">
            {{doc.fields.quickstart.body|render|markdown|highlightCode|safe}}
          </div>
        </section>
        {% endif %}

        {% if doc.fields.features %}
        <section class="home-section">
          <h2>{{doc.fields.features.title}}</h2>
          <div class="feature-grid">
            {% for feat in doc.fields.features.items %}
              <div class="feature-card">
                <h3>{{feat.title}}</h3>
                <p>{{feat.body|render|safe}}</p>
              </div>
            {% endfor %}
          </div>
        </section>
        {% endif %}

        {% if doc.fields.sections %}
          {% for sec in doc.fields.sections %}
          <section class="home-section">
            <div class="docs-content docs-content--compact">
              {{sec.body|render|markdown|highlightCode|safe}}
            </div>
          </section>
          {% endfor %}
        {% endif %}
      </main>
    {% else %}
      <div class="docs-shell">
        <aside class="docs-sidebar" id="docs-sidebar" role="navigation" aria-label="Documentation">
          <div class="sidebar__mobile-header">
            <span>{% if isApi %}API Reference{% else %}Documentation{% endif %}</span>
            <button type="button" class="nav-close" id="nav-close" aria-label="Close navigation">&times;</button>
          </div>
          <div class="sidebar__mobile-tabs">
            <a href="/docs/" class="topbar__link{% if isDocs %} is-active{% endif %}">Docs</a>
            <a href="/api/" class="topbar__link{% if isApi %} is-active{% endif %}">API</a>
          </div>

          {% for section in getSidebarSections(sidebarRoot) %}
            <div class="sidebar__heading">{{section.title}}</div>
            {% for item in section.docs %}
              <a
                class="sidebar__link{% if doc.podPath == item.podPath %} is-active{% endif %}"
                href="{{item.url.path}}"
              >{{item.fields.title}}</a>
            {% endfor %}
          {% endfor %}

          <div class="sidebar__badges">
            <a href="https://www.npmjs.com/package/@amagaki/amagaki" target="_blank" rel="noopener">
              <img src="https://img.shields.io/npm/v/@amagaki/amagaki.svg?style=flat" alt="npm version">
            </a>
            <a href="https://github.com/blinkk/amagaki/actions/workflows/test-amagaki.yml" target="_blank" rel="noopener">
              <img src="https://img.shields.io/github/actions/workflow/status/blinkk/amagaki/test-amagaki.yml?branch=main&amp;label=CI&amp;style=flat" alt="CI status">
            </a>
            <a href="https://github.com/blinkk/amagaki/blob/main/LICENSE.md" target="_blank" rel="noopener">
              <img src="https://img.shields.io/badge/license-MIT-blue.svg?style=flat" alt="License">
            </a>
          </div>
        </aside>

        <main class="docs-content" role="main">
          {{doc.body|render|markdown|highlightCode|safe}}
          {% set pager = getPager(doc, sidebarRoot) %}
          {% if pager.prev or pager.next %}
            <nav class="pager" aria-label="Pagination">
              {% if pager.prev %}
                <a href="{{pager.prev.url.path}}" class="pager__link"><svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l14 0"/><path d="M5 12l6 6"/><path d="M5 12l6 -6"/></svg>{{pager.prev.fields.title}}</a>
              {% else %}
                <span></span>
              {% endif %}
              {% if pager.next %}
                <a href="{{pager.next.url.path}}" class="pager__link">{{pager.next.fields.title}}<svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l14 0"/><path d="M13 18l6 -6"/><path d="M13 6l6 6"/></svg></a>
              {% endif %}
            </nav>
          {% endif %}
        </main>

        <aside class="docs-toc" role="complementary" aria-label="On this page">
          <div class="toc__title">On this page</div>
          <ul class="toc__list" id="docs-toc"></ul>
          <div class="toc__footer">
            <a
              href="{{pod.meta.githubEditRoot}}{{doc.podPath}}"
              class="toc__edit"
              target="_blank"
              rel="noopener"
            >Edit this page on GitHub<svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 7l-10 10"/><path d="M8 7l9 0l0 9"/></svg></a>
          </div>
        </aside>
      </div>
    {% endif %}

    <footer class="site-footer" role="contentinfo">
      <div class="site-footer__inner">
        <div class="site-footer__top">
          <div class="site-footer__team">
            <h2 class="site-footer__team-heading">Meet the team</h2>
            <p class="site-footer__team-body">Amagaki was handcrafted by the team at <a href="https://blinkk.com/" target="_blank" rel="noopener">Blinkk</a>. We offer custom solutions and forward deployments, including full integration and maintenance of Root.js sites on your infrastructure.</p>
            <a class="site-footer__cta" href="https://blinkk.com/services" target="_blank" rel="noopener">Explore services<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l14 0"/><path d="M13 18l6 -6"/><path d="M13 6l6 6"/></svg></a>
          </div>
          <nav class="site-footer__columns" aria-label="Footer">
            <div class="site-footer__column">
              <h2 class="site-footer__heading">Resources</h2>
              <ul class="site-footer__list">
                <li><a href="/docs/">Docs</a></li>
                <li><a href="/docs/getting-started/installation/">Installation</a></li>
                <li><a href="/docs/getting-started/starter-project/">Starter Project</a></li>
                <li><a href="/docs/getting-started/cli/">CLI</a></li>
                <li><a href="{{pod.meta.githubUrl}}/releases" target="_blank" rel="noopener">Releases</a></li>
              </ul>
            </div>
            <div class="site-footer__column">
              <h2 class="site-footer__heading">Reference</h2>
              <ul class="site-footer__list">
                <li><a href="/api/">API Reference</a></li>
                <li><a href="/docs/templates/">Templates</a></li>
                <li><a href="/docs/plugins/">Plugins</a></li>
                <li><a href="/docs/localization/">Localization</a></li>
              </ul>
            </div>
            <div class="site-footer__column">
              <h2 class="site-footer__heading">Ecosystem</h2>
              <ul class="site-footer__list">
                <li><a class="site-footer__eco-link" href="https://rootjs.dev" target="_blank" rel="noopener"><img class="site-footer__eco-icon" src="{{pod.staticFile('/static/images/rootjs-beet.svg').url.path}}" alt="" width="15" height="15">Root.js</a></li>
                <li><a class="site-footer__eco-link" href="https://grow.dev" target="_blank" rel="noopener"><img class="site-footer__eco-icon" src="{{pod.staticFile('/static/images/grow.png').url.path}}" alt="" width="15" height="15">Grow</a></li>
                <li><a class="site-footer__eco-link" href="https://www.npmjs.com/package/@amagaki/amagaki" target="_blank" rel="noopener"><svg class="site-footer__eco-icon" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"/></svg>npm</a></li>
              </ul>
            </div>
          </nav>
        </div>

        <div class="site-footer__bottom">
          <div class="site-footer__legal">
            <img src="{{pod.staticFile('/static/images/amagaki.svg').url.path}}" alt="" width="20" height="20">
            <span>MIT License &copy; 2026</span>
            <a href="https://blinkk.com/" target="_blank" rel="noopener">Blinkk</a>
          </div>
          <div class="site-footer__social">
            <a href="{{pod.meta.githubUrl}}" target="_blank" rel="noopener" aria-label="GitHub">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.475 2 2 6.475 2 12a9.994 9.994 0 0 0 6.838 9.488c.5.087.687-.213.687-.476 0-.237-.013-1.024-.013-1.862-2.512.463-3.162-.612-3.362-1.175-.113-.287-.6-1.175-1.025-1.412-.35-.188-.85-.65-.013-.663.788-.012 1.35.725 1.538 1.025.9 1.512 2.338 1.087 2.912.825.088-.65.35-1.087.638-1.337-2.225-.25-4.55-1.113-4.55-4.938 0-1.087.387-1.987 1.025-2.687-.1-.25-.45-1.275.1-2.65 0 0 .837-.263 2.75 1.024a9.28 9.28 0 0 1 2.5-.337c.85 0 1.7.112 2.5.337 1.912-1.3 2.75-1.024 2.75-1.024.55 1.375.2 2.4.1 2.65.637.7 1.025 1.587 1.025 2.687 0 3.838-2.337 4.688-4.562 4.938.362.312.675.912.675 1.85 0 1.337-.013 2.412-.013 2.75 0 .262.188.574.688.474A10.016 10.016 0 0 0 22 12c0-5.525-4.475-10-10-10z"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/blinkk" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script src="{{pod.staticFile('/static/js/docs.js').url.path}}?v={{pod.staticFile('/static/js/docs.js').fingerprint}}"></script>
  </body>
</html>
